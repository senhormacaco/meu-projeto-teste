<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>{{ settings.store_heading }}</title>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>
    :root {
      --color-primary: {{ settings.primary_color }};
      --color-secondary: {{ settings.secondary_color }};
      --color-highlight: {{ settings.highlight_color }};
      --color-text: {{ settings.text_color }};
      --color-background: {{ settings.background_color }};
    }
  </style>
  {{ content_for_header }}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "{{ shop.name }}",
      "url": "{{ shop.url }}"
    }
  </script>
</head>
<body style="background: var(--color-background); color: var(--color-text);">
  {{ section 'promo-bar' }}
  {{ section 'header' }}
  {{ section 'category-menu' }}
  <main>
    {{ content_for_layout }}
  </main>
  {{ section 'footer' }}
  {% if settings.whatsapp_number %}
  <a href="https://wa.me/{{ settings.whatsapp_number }}?text={{ settings.whatsapp_message | url_encode }}" class="whatsapp-float" style="background: {{ settings.whatsapp_color }};">WhatsApp</a>
  {% endif %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": []
    }
  </script>
</body>
</html>
