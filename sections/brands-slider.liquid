<div class="brands-slider">
  {% for block in section.blocks %}
    <a class="brand" href="{{ block.settings.link }}">
      {% if block.settings.logo %}<img src="{{ block.settings.logo | img_url: '200x' }}" alt="">{% endif %}
    </a>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Marcas",
  "settings": [],
  "max_blocks": 10,
  "blocks": [
    {
      "type": "brand",
      "name": "Marca",
      "settings": [
        {"type": "image_picker", "id": "logo", "label": "Logo"},
        {"type": "url", "id": "link", "label": "Link"}
      ]
    }
  ]
}
{% endschema %}
