<div class="benefits-strip">
  {% for block in section.blocks %}
    <div class="benefit">
      {% if block.settings.icon %}<img src="{{ block.settings.icon | img_url: '50x' }}" alt="">{% endif %}
      <span>{{ block.settings.text }}</span>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Faixa de benefícios",
  "settings": [],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefício",
      "settings": [
        {"type": "image_picker", "id": "icon", "label": "Ícone"},
        {"type": "text", "id": "text", "label": "Texto"}
      ]
    }
  ]
}
{% endschema %}
