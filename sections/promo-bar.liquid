<div class="promo-bar">
  <span>{{ settings.promo_message }}</span>
  <span>
    {{ settings.phone }}
    {% if settings.facebook_link %}<a href="{{ settings.facebook_link }}" aria-label="Facebook">FB</a>{% endif %}
    {% if settings.instagram_link %}<a href="{{ settings.instagram_link }}" aria-label="Instagram">IG</a>{% endif %}
    {% if settings.youtube_link %}<a href="{{ settings.youtube_link }}" aria-label="YouTube">YT</a>{% endif %}
  </span>
</div>

{% schema %}
{
  "name": "Faixa superior",
  "settings": []
}
{% endschema %}
